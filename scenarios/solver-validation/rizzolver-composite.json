{
  "name": "rizzolver-supported-pairs-and-creations",
  "solver": "rizzolver",
  "env": "staging",
  "breakSeconds": 30,
  "scenarios": [
    "solver-standard-pairs.csv",
    "rizzolver-sol-jup.csv",
    "solver-same-direction-25.csv",
    "solver-burst-sell.csv"
  ],
  "options": {
    "solFundingPerTrader": 0.07,
    "maxTotalSol": 3,
    "maxCreationSol": 0.602,
    "maxRetries": 0,
    "orderValidity": 300,
    "fillTimeout": 180,
    "cancelOnTimeout": true,
    "cleanup": true,
    "report": true
  }
}
