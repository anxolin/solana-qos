{
  "name": "jupiter-core-token-coverage-xstocks-and-token-2022-pairs",
  "solver": "jupiter",
  "env": "prod",
  "breakSeconds": 30,
  "scenarios": [
    "solver-standard-pairs.csv",
    "../jupiter/receiving-account-costs.csv",
    "../jupiter/native-vs-wrapped-payouts.csv",
    "../jupiter/amount-precision.csv",
    "../token-2022/token-2022-to-token-2022.csv",
    "../jupiter/token-coverage-gaps.csv",
    "../token-2022/xstocks.csv",
    "../jupiter/failure-isolation.csv"
  ],
  "options": {
    "solFundingPerTrader": 0.08,
    "maxTotalSol": 1.76,
    "maxCreationSol": 0.981,
    "maxRetries": 0,
    "orderValidity": 300,
    "fillTimeout": 60,
    "cancelOnTimeout": true,
    "quoteRps": 2,
    "apiRps": 5,
    "rpcRps": 8,
    "cleanup": true,
    "report": true
  }
}
