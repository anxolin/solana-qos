{
  "name": "rosato-standard-load-and-token-sample",
  "solver": "rosato",
  "env": "staging",
  "breakSeconds": 30,
  "scenarios": [
    "solver-standard-pairs.csv",
    "solver-same-direction-25.csv",
    "solver-burst-sell-small.csv",
    "solver-cow.csv",
    "solver-token-sample.csv"
  ],
  "options": {
    "solFundingPerTrader": 0.07,
    "maxTotalSol": 2,
    "maxCreationSol": 0.483,
    "maxRetries": 0,
    "orderValidity": 300,
    "fillTimeout": 180,
    "cancelOnTimeout": true,
    "prepareTokenAccounts": false,
    "cleanup": true,
    "report": true
  }
}
