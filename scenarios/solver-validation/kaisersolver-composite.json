{
  "name": "kaisersolver-routing-load-and-compatibility",
  "solver": "kaisersolver",
  "env": "staging",
  "breakSeconds": 30,
  "scenarios": [
    "solver-standard-pairs.csv",
    "../jupiter/receiving-account-costs.csv",
    "../jupiter/native-vs-wrapped-payouts.csv",
    "solver-same-direction-25.csv",
    "solver-burst-sell.csv",
    "solver-token-coverage.csv",
    {
      "path": "solver-fresh-accounts.csv",
      "options": {
        "freshAccounts": true,
        "solFundingPerTrader": 0.15,
        "slippageBps": 500
      }
    }
  ],
  "options": {
    "solFundingPerTrader": 0.05,
    "maxTotalSol": 3,
    "maxCreationSol": 0.993,
    "maxRetries": 0,
    "orderValidity": 300,
    "fillTimeout": 60,
    "cancelOnTimeout": true,
    "quoteRps": 5,
    "apiRps": 8,
    "rpcRps": 10,
    "cleanup": true,
    "report": true
  }
}
