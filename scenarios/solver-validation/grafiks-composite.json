{
  "name": "grafiks-five-scenarios",
  "solver": "grafiks",
  "env": "staging",
  "breakSeconds": 30,
  "scenarios": [
    "solver-same-direction-25.csv",
    "solver-burst-sell.csv",
    "solver-cow.csv",
    "solver-token-coverage.csv",
    "solver-transaction-size.csv"
  ],
  "options": {
    "solFundingPerTrader": 0.07,
    "maxTotalSol": 3,
    "maxCreationSol": 0.939,
    "maxRetries": 0,
    "orderValidity": 300,
    "fillTimeout": 60,
    "cancelOnTimeout": true,
    "cleanup": true,
    "report": true
  }
}
