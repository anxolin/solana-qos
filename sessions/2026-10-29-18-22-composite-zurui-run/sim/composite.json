{
  "name": "zurui-routing-load-and-compatibility",
  "solver": "zurui",
  "env": "staging",
  "breakSeconds": 30,
  "scenarios": [
    "solver-standard-pairs.csv",
    "../jupiter/native-vs-wrapped-payouts.csv",
    {
      "path": "../jupiter/receiving-account-costs.csv",
      "options": {
        "freshAccounts": true
      }
    },
    "solver-same-direction-25.csv",
    "solver-burst-sell.csv",
    "solver-cow.csv",
    "solver-token-coverage.csv",
    {
      "path": "../token-2022/xstocks.csv",
      "options": {
        "solFundingPerTrader": 0.08
      }
    }
  ],
  "options": {
    "solFundingPerTrader": 0.07,
    "maxTotalSol": 3,
    "maxCreationSol": 1.44,
    "maxRetries": 0,
    "orderValidity": 300,
    "fillTimeout": 180,
    "cancelOnTimeout": true,
    "prepareTokenAccounts": false,
    "cleanup": true,
    "report": true
  }
}
